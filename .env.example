# ==========================================
# CẤU HÌNH KẾT NỐI MONGODB ATLAS
# ==========================================

# Chuỗi kết nối MongoDB Atlas (bắt buộc cả trên Local và trên Vercel Environment Variables):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jack_portfolio?retryWrites=true&w=majority

# Cổng chạy API Server Backend (khi chạy local):
PORT=5000

# ==========================================
# CẤU HÌNH DEPLOY VERCEL (TÙY CHỌN)
# ==========================================
# Nếu deploy fullstack trên Vercel (Frontend + Serverless API): Để trống.
# Nếu deploy Backend riêng trên Render/Railway: Điền URL Backend (ví dụ: https://my-backend.onrender.com)
# VITE_API_URL=https://my-backend.onrender.com
